PORT=8011
NODE_ENV=development

# New database for this service (not shared with smatpay_whatsapp).
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=smatpay_kyc
DB_USERNAME=root
DB_PASSWORD=

# For scripts calling /api/admin (sent as X-Admin-Key). The /admin site signs in instead. Empty = header refused.
# node -e "console.log(require("crypto").randomBytes(32).toString("base64url"))"
ADMIN_API_KEY=

# CIPZ company register, no trailing slash.
CIPZ_BASE_URL=https://cipz.pfms.gov.zw:8090
CIPZ_TIMEOUT_MS=15000

# OpenSanctions matching API: a self-hosted yente (see docker/yente) or https://api.opensanctions.org.
YENTE_URL=http://localhost:8000
# Only for the hosted API; a self-hosted yente needs no key.
YENTE_API_KEY=
# "default" covers sanctions, PEPs and other risk lists; "sanctions" is sanctions only.
YENTE_DATASET=default
# Score at or above which a candidate counts as a hit (yente's default is 0.7).
YENTE_THRESHOLD=0.7
YENTE_ALGORITHM=best
YENTE_TIMEOUT_MS=15000

# Email (SendGrid), used to send new clients their access token. Same account as tese-backend.
SENDGRID_API_KEY=
MAIL_FROM_EMAIL=no-reply@tese.africa
MAIL_FROM_NAME=Smatid KYC

# Admin site (smatid_kyc_web). Exact origins, comma-separated, e.g. https://kyc.smatid.com
CORS_ORIGINS=
# How long an admin stays signed in.
ADMIN_SESSION_HOURS=12

# Liveness. The address people open the hosted page on, e.g. https://dev-api.smatid.com
# (empty: worked out from each request, which behind Apache comes out as http://).
PUBLIC_BASE_URL=
LIVENESS_SESSION_MINUTES=30
LIVENESS_MAX_ATTEMPTS=3
# Where the captured frames are kept for review. Default: storage/liveness in this folder.
LIVENESS_STORAGE_DIR=
# Local testing only: lets webhooks go to http://localhost. Never on a server.
WEBHOOK_ALLOW_PRIVATE=

# Credits: prices, packs and the free trial.
CREDIT_PRICE=0.10
CREDIT_CURRENCY=USD
CREDIT_PACKAGES=100,500,1000,5000
TRIAL_CREDITS=50
TRIAL_DAYS=30
# The client portal (smatid_kyc_web), for links in emails, and how long a portal sign-in lasts.
PORTAL_URL=http://localhost:5173
PORTAL_SESSION_HOURS=24

# SmatPay merchant that receives credit top-ups. SMATPAY_PLANE=sandbox simulates payments and uses the
# SMATPAY_SANDBOX_* keys; otherwise SMATPAY_MERCHANT_KEY and SMATPAY_MERCHANT_API_KEY are used.
SMATPAY_API_URL=
SMATPAY_PLANE=sandbox
SMATPAY_MERCHANT_ID=
SMATPAY_MERCHANT_KEY=
SMATPAY_MERCHANT_API_KEY=
SMATPAY_SANDBOX_MERCHANT_KEY=
SMATPAY_SANDBOX_MERCHANT_API_KEY=
SMATPAY_MERCHANT_ACCOUNT_ID=
# The 7-digit payment profile number payments go to.
SMATPAY_PROFILE_NUMBER=

# Encrypts secret settings saved from the admin site (e.g. Smatpay keys). 32 bytes, base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and never change it: settings saved with the old one can't be read.
SETTINGS_ENCRYPTION_KEY=

# Passport scans: the largest photo page picture accepted, and where pictures are kept (default storage/passport).
PASSPORT_MAX_IMAGE_KB=2048
PASSPORT_STORAGE_DIR=

# Face match (passport photo vs liveness): SFace cosine similarity bars.
FACE_MATCH_MIN_MATCH=0.4
FACE_MATCH_MIN_REVIEW=0.25
