PORT=8011
NODE_ENV=development

# New database for this service (not shared with smatpay_whatsapp).
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=smatpay_kyc
DB_USERNAME=root
DB_PASSWORD=

# For scripts calling /api/admin (sent as X-Admin-Key). The /admin site signs in instead. Empty = header refused.
# node -e "console.log(require("crypto").randomBytes(32).toString("base64url"))"
ADMIN_API_KEY=

# CIPZ company register, no trailing slash.
CIPZ_BASE_URL=https://cipz.pfms.gov.zw:8090
CIPZ_TIMEOUT_MS=15000

# OpenSanctions matching API: a self-hosted yente (see docker/yente) or https://api.opensanctions.org.
YENTE_URL=http://localhost:8000
# Only for the hosted API; a self-hosted yente needs no key.
YENTE_API_KEY=
# "default" covers sanctions, PEPs and other risk lists; "sanctions" is sanctions only.
YENTE_DATASET=default
# Score at or above which a candidate counts as a hit (yente's default is 0.7).
YENTE_THRESHOLD=0.7
YENTE_ALGORITHM=best
YENTE_TIMEOUT_MS=15000

# Email (SendGrid), used to send new clients their access token. Same account as tese-backend.
SENDGRID_API_KEY=
MAIL_FROM_EMAIL=no-reply@tese.africa
MAIL_FROM_NAME=Smatid KYC

# Admin site (smatid_kyc_web). Exact origins, comma-separated, e.g. https://kyc.smatid.com
CORS_ORIGINS=
# How long an admin stays signed in.
ADMIN_SESSION_HOURS=12
