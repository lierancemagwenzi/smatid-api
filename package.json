{
  "name": "smatpay_kyc",
  "version": "1.0.0",
  "description": "Smatid KYC checks: company registration, ID and passport extraction, photo match, liveness, sanctions",
  "main": "app.js",
  "private": true,
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node --test test/*.test.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "admin:create": "node scripts/createAdmin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@vladmandic/human": "^3.3.6",
    "axios": "^1.12.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jpeg-js": "^0.4.4",
    "morgan": "^1.10.1",
    "mysql2": "^3.24.6",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.5"
  }
}
